# Пароль входа в /admin (обязательно задать на сервере)
ADMIN_PASSWORD=
# Любая длинная случайная строка для подписи сессии: openssl rand -hex 32
SESSION_SECRET=

# Уведомления о заявках в Telegram: создайте бота у @BotFather,
# добавьте его в чат администратора и укажите ID чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Папка с контентом, заявками и фото (по умолчанию ./data)
DATA_DIR=

# Аналитика (необязательно)
PUBLIC_GA_ID=
PUBLIC_YM_ID=

# CRM NS Barber: адрес API и ключ сайта (SITE_API_KEY из CRM)
CRM_API_URL=
CRM_API_KEY=
