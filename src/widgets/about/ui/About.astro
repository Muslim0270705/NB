---
import type { SiteContent } from '@/entities/content';
import { pluralize } from '@/shared/lib/format';
import { NumberCounter } from '@/shared/ui/number-counter';
import SectionHeading from '@/shared/ui/section-heading.astro';

interface Props {
	content: SiteContent;
}

const { gallery, masters, rating, categories } = Astro.props.content;
const servicesCount = categories.reduce((n, c) => n + c.services.length, 0);
const realMasters = masters.filter((m) => m.name && m.name !== 'Имя мастера').length;

// Крупные цифры как в блоке «Почему мы?» Nomad College
const stats: { target: number; suffix?: string; static?: string; label: string }[] = [
	...(rating.count > 0
		? [
				{
					target: 0,
					static: rating.value.toFixed(1),
					label: `рейтинг в 2ГИС · ${rating.count} ${pluralize(rating.count, ['оценка', 'оценки', 'оценок'])}`,
				},
			]
		: []),
	{
		target: servicesCount,
		label: `${pluralize(servicesCount, ['услуга', 'услуги', 'услуг'])} для взрослых и детей`,
	},
	...(realMasters > 0
		? [
				{
					target: realMasters,
					label: `${pluralize(realMasters, ['мастер', 'мастера', 'мастеров'])} в команде`,
				},
			]
		: []),
];
const interior = gallery.filter((g) => g.src && g.category === 'interior');
const photo = interior[1] ?? interior[0];

const values = [
	{
		title: 'Качество',
		text: 'Профессиональная косметика, стерильный инструмент и внимание к каждой детали — от консультации до финальной укладки.',
	},
	{
		title: 'Стиль',
		text: 'Подбираем форму под тип лица и волос, образ жизни и ваш характер. Классика и современные техники.',
	},
	{
		title: 'Профессионализм',
		text: 'Мастера регулярно повышают квалификацию. К нам приходят надолго — и к своему мастеру.',
	},
];
---

<section id='about' aria-labelledby='about-title' class='bg-paper py-16 lg:py-[100px]'>
	<div class='section-container'>
		<!-- Как «Почему мы?» в Nomad College: подпись слева, заголовок справа; цифры и фото ниже -->
		<div class='mb-12 flex flex-col gap-6 lg:mb-20 lg:grid lg:grid-cols-[416px_1fr]'>
			<SectionHeading eyebrow='О студии' />
			<div class='flex flex-col gap-4 animate-on-scroll opacity-0 translate-y-6 transition-all duration-700 ease-out delay-100 lg:gap-6'>
				<h2 id='about-title' class='text-h2 font-bold'>Место, куда хочется возвращаться</h2>
				<p class='text-body-lg text-ink/80 lg:max-w-[811px] lg:text-h5'>
					NS Barber Studio — барбершоп для тех, кто ценит точность и спокойный сервис. Без спешки:
					только мастер, хороший инструмент и результат, который держит форму.
				</p>
			</div>
		</div>

		<div class='flex flex-col gap-8 lg:grid lg:grid-cols-[416px_1fr] lg:gap-6'>
			<div class='flex flex-col gap-12 lg:gap-[72px] lg:pt-10'>
				{
					stats.map((stat, i) => (
						<div
							class:list={[
								'flex flex-col gap-3 animate-on-scroll opacity-0 translate-y-6 transition-all duration-700 ease-out lg:gap-4',
								i === 1 && 'delay-150',
								i === 2 && 'delay-300',
							]}
						>
							<div class='text-[4rem] font-bold leading-none lg:text-[7rem]'>
								{stat.static ?? <NumberCounter client:visible target={stat.target} suffix={stat.suffix} />}
							</div>
							<div class='inline-flex w-fit items-center bg-cream px-[14px] py-2'>
								<span class='text-body-md font-medium uppercase'>{stat.label}</span>
							</div>
						</div>
					))
				}
			</div>

			<div class='relative min-h-[320px] overflow-hidden animate-on-scroll opacity-0 translate-x-10 transition-all duration-700 ease-out delay-200 lg:min-h-[720px]'>
				{
					photo ? (
						<img
							src={photo.thumb ?? photo.src}
							alt={photo.alt}
							loading='lazy'
							class='absolute inset-0 size-full object-cover'
						/>
					) : (
						<div class='photo-placeholder absolute inset-0 flex items-end p-6'>
							<span class='eyebrow'>Интерьер студии</span>
						</div>
					)
				}
			</div>
		</div>

		<ol class='mt-16 grid gap-4 md:grid-cols-3 lg:mt-24 lg:gap-6'>
			{
				values.map((v, i) => (
					<li
						class:list={[
							'flex flex-col gap-4 border-t-2 border-ink bg-cream p-6 lg:p-8',
							'animate-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out',
							i === 1 && 'delay-150',
							i === 2 && 'delay-300',
						]}
					>
						<span class='text-body-md font-medium text-stone'>0{i + 1}</span>
						<h3 class='text-h3 font-bold'>{v.title}</h3>
						<p class='text-body-lg text-ink/80'>{v.text}</p>
					</li>
				))
			}
		</ol>

		{
			masters.length > 0 && (
				<div class='mt-24'>
					<SectionHeading eyebrow='Команда' title='Наши мастера' />
					<ul class='mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-8'>
						{masters.map((m, i) => (
							<li
								class:list={[
									'flex flex-col gap-4',
									'animate-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out',
									i % 4 === 1 && 'delay-100',
									i % 4 === 2 && 'delay-200',
									i % 4 === 3 && 'delay-300',
								]}
							>
								<div class='relative aspect-[3/4] overflow-hidden'>
									{m.photo ? (
										<img
											src={m.photo}
											alt={`${m.name} — ${m.role}`}
											loading='lazy'
											class='size-full object-cover grayscale transition-all duration-700 hover:grayscale-0'
										/>
									) : (
										<div class='photo-placeholder flex size-full items-center justify-center'>
											<span class='text-h1 font-bold text-ink/15'>NS</span>
										</div>
									)}
								</div>
								<div>
									<p class='text-body-xl font-bold'>{m.name}</p>
									{m.role && <p class='text-body-md text-stone'>{m.role}</p>}
								</div>
							</li>
						))}
					</ul>
				</div>
			)
		}
	</div>
</section>
