---
import { Star } from 'lucide-react';
import type { SiteContent } from '@/entities/content';
import { findService } from '@/entities/content';
import { BOOKING_ANCHOR, SITE } from '@/shared/config/site';
import { formatPrice } from '@/shared/lib/format';
import { telLink } from '@/shared/lib/links';
import { displayPhone } from '@/shared/lib/phone';
import { AnimatedText } from '@/shared/ui/animated-text';
import CtaLink from '@/shared/ui/cta-link.astro';
import { Logo } from '@/shared/ui/logo';
import { RevealingCardContent } from '@/shared/ui/revealing-card-content';

interface Props {
	content: SiteContent;
}

const { content } = Astro.props;
const { contacts, rating } = content;

// Обложка: первое загруженное фото интерьера (или любое), иначе — тёмная фирменная заглушка
const cover =
	content.gallery.find((g) => g.src && g.category === 'interior') ??
	content.gallery.find((g) => g.src);

const mainService =
	findService(content, 'men-cut') ?? content.categories.flatMap((c) => c.services)[0];
---

<!-- Первый экран как в Nomad College: фото во весь экран, крупное название, стеклянные карточки -->
<section aria-labelledby='hero-title' class='relative min-h-[680px] overflow-hidden bg-ink lg:min-h-screen'>
	{
		cover ? (
			<img
				src={cover.src}
				alt=''
				aria-hidden='true'
				width={cover.width}
				height={cover.height}
				fetchpriority='high'
				class='absolute inset-0 size-full object-cover object-center'
			/>
		) : (
			<div class='photo-placeholder-dark absolute inset-0 flex items-center justify-end overflow-hidden'>
				<Logo variant='mark' inverted className='h-auto w-[70%] max-w-[760px] translate-x-[12%] opacity-[0.07]' title='' />
			</div>
		)
	}

	<!-- Затемнение сверху (читаемость шапки) и слева (читаемость текста) -->
	<div aria-hidden='true' class='absolute inset-0 bg-gradient-to-b from-black/40 from-[10%] to-transparent to-[70%]'></div>
	<div aria-hidden='true' class='absolute inset-0 bg-gradient-to-r from-black/64 to-transparent'></div>

	<div class='section-container relative flex min-h-[680px] flex-col lg:min-h-screen'>
		<div class='flex flex-col gap-3 pt-[100px] lg:max-w-[760px] lg:gap-4 lg:pt-[188px]'>
			<h1 id='hero-title' class='text-display font-bold text-white'>
				<AnimatedText client:load text='NS Barber' />
				<AnimatedText client:load text='Studio' initialDelay={0.4} isOdd className='-mt-3 py-3' />
				<span class='sr-only'> — барбершоп в Бишкеке: мужские и детские стрижки, борода, уход</span>
			</h1>

			<p class='hero-in max-w-[343px] text-body-lg font-normal text-white/80 [animation-delay:700ms] lg:max-w-[520px] lg:text-h5'>
				Барбершоп в Бишкеке: точные стрижки, аккуратная борода и спокойная атмосфера
			</p>

			<div class='hero-in mt-4 flex flex-wrap items-center gap-3 [animation-delay:900ms] lg:mt-6'>
				<CtaLink href={BOOKING_ANCHOR}>Записаться онлайн</CtaLink>
				<a
					href='#services'
					class='inline-flex h-12 items-center px-6 text-body-md font-semibold text-white transition-colors glass-card hover:bg-white/[0.2] lg:h-14 lg:text-body-lg'
				>
					Цены
				</a>
			</div>
		</div>

		<!-- Стеклянные карточки: на мобиле — в потоке, на десктопе — разбросаны по фото -->
		<div class='mt-10 grid grid-cols-2 gap-3 pb-10 lg:contents'>
			{
				rating.count > 0 && (
					<a
						href={contacts.twoGisUrl}
						target='_blank'
						rel='noopener noreferrer'
						class='glass-card block transition-colors hover:bg-white/[0.18] lg:absolute lg:right-[280px] lg:top-[220px] lg:w-[200px]'
					>
						<RevealingCardContent client:load delay={0.5}>
							<div class='p-4 lg:p-5'>
								<p class='mb-3 text-body-md font-medium text-white/60 lg:mb-6'>Рейтинг 2ГИС</p>
								<p class='flex items-center gap-2 text-white'>
									<span class='text-h3 font-bold'>{rating.value.toFixed(1)}</span>
									<span class='flex gap-0.5' aria-label={`Рейтинг ${rating.value} из 5`}>
										{Array.from({ length: 5 }, () => (
											<Star size={13} fill='currentColor' />
										))}
									</span>
								</p>
							</div>
						</RevealingCardContent>
					</a>
				)
			}

			{
				mainService && (
					<div class='glass-card lg:absolute lg:bottom-[100px] lg:right-[120px] lg:w-[340px]'>
						<RevealingCardContent client:load delay={1.1}>
							<div class='p-4 lg:p-5'>
								<p class='mb-3 text-body-md font-medium text-white/60 lg:mb-6'>{mainService.name}</p>
								<p class='text-body-md font-medium text-white lg:text-body-xl'>
									от {formatPrice(mainService.price)} сом · профессиональная косметика и стерильный инструмент
								</p>
							</div>
						</RevealingCardContent>
					</div>
				)
			}

			<div class='glass-card col-span-2 lg:absolute lg:bottom-[160px] lg:left-auto lg:right-[500px] lg:w-[300px]'>
				<RevealingCardContent client:load delay={0.8}>
					<div class='p-4 lg:p-5'>
						<p class='mb-3 text-body-md font-medium text-white/60 lg:mb-6'>
							{contacts.hoursDays}, {contacts.openFrom}–{contacts.openTo}
						</p>
						<p class='text-body-md font-medium text-white lg:text-body-xl'>
							{SITE.city}, {contacts.address}
						</p>
						{
							contacts.phone && (
								<a href={telLink(contacts.phone)} class='mt-2 block text-body-md font-semibold text-white hover:underline lg:text-body-lg'>
									{displayPhone(contacts.phone)}
								</a>
							)
						}
					</div>
				</RevealingCardContent>
			</div>
		</div>
	</div>
</section>
