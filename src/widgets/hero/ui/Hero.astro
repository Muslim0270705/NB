---
import { Clock, MapPin, Phone, Star } from 'lucide-react';
import type { SiteContent } from '@/entities/content';
import { findService } from '@/entities/content';
import { BOOKING_ANCHOR, SITE } from '@/shared/config/site';
import { formatPrice } from '@/shared/lib/format';
import { instagramLink, telLink } from '@/shared/lib/links';
import { displayPhone } from '@/shared/lib/phone';
import { buttonClass } from '@/shared/ui/button-styles';
import { InstagramIcon, TwoGisIcon } from '@/shared/ui/icons';
import { Logo } from '@/shared/ui/logo';

interface Props {
	content: SiteContent;
}

const { content } = Astro.props;
const { contacts, rating } = content;

// Обложка: первое загруженное фото интерьера (или любое), иначе — фирменная заглушка
const cover =
	content.gallery.find((g) => g.src && g.category === 'interior') ??
	content.gallery.find((g) => g.src);

// Краткий блок услуг на первом экране
const highlights = ['men-cut', 'beard-design', 'cut-beard', 'kids-cut']
	.map((id) => findService(content, id))
	.filter(Boolean)
	.slice(0, 4);
const shortList = highlights.length
	? highlights
	: content.categories.flatMap((c) => c.services).slice(0, 4);
---

<section aria-labelledby='hero-title' class='relative overflow-hidden pt-16 lg:pt-20'>
	<div class='section-container grid gap-10 pb-12 pt-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pb-16 lg:pt-14'>
		<div class='flex flex-col justify-center'>
			<p
				class='eyebrow hero-in'
			>
				Барбершоп · {SITE.city}
			</p>

			<h1
				id='hero-title'
				class='mt-6 hero-in [animation-delay:100ms]'
			>
				<Logo className='h-auto w-full max-w-[560px]' title='' />
				<span class='sr-only'>NS Barber Studio</span>
				<span class='sr-only'> — барбершоп в Бишкеке: мужские и детские стрижки, борода, уход</span>
			</h1>

			<p
				class='mt-8 text-caption font-semibold uppercase tracking-[0.3em] text-stone hero-in [animation-delay:200ms]'
			>
				{SITE.slogan}
			</p>
			<p
				class='mt-5 max-w-[480px] text-body-xl text-stone hero-in [animation-delay:300ms]'
			>
				Точные стрижки, аккуратная борода и спокойная атмосфера. Записывайтесь онлайн — это
				займёт меньше минуты.
			</p>

			<div
				class='mt-9 flex flex-wrap gap-3 hero-in [animation-delay:300ms]'
			>
				<a href={BOOKING_ANCHOR} class={buttonClass('primary', 'lg')}>Записаться онлайн</a>
				<a href='#services' class={buttonClass('outline', 'lg')}>Цены</a>
			</div>

			<div
				class='mt-6 flex flex-wrap gap-2 hero-in [animation-delay:500ms]'
			>
				<a
					href={instagramLink(contacts.instagram)}
					target='_blank'
					rel='noopener noreferrer'
					class='inline-flex h-10 items-center gap-2 border border-ink/15 px-4 text-caption font-semibold uppercase tracking-[0.16em] transition-colors hover:border-ink'
				>
					<InstagramIcon size={16} /> Instagram
				</a>
				<a
					href={contacts.twoGisUrl}
					target='_blank'
					rel='noopener noreferrer'
					class='inline-flex h-10 items-center gap-2 border border-ink/15 px-4 text-caption font-semibold uppercase tracking-[0.16em] transition-colors hover:border-ink'
				>
					<TwoGisIcon size={16} /> 2ГИС
				</a>
			</div>
		</div>

		<div
			class='relative min-h-[420px] hero-in [animation-delay:200ms] lg:min-h-[620px]'
		>
			{
				cover ? (
					<img
						src={cover.src}
						alt={cover.alt}
						width={cover.width}
						height={cover.height}
						fetchpriority='high'
						class='absolute inset-0 size-full object-cover'
					/>
				) : (
					<div class='photo-placeholder-dark absolute inset-0 flex items-center justify-center'>
						<Logo variant='mark' inverted className='h-auto w-3/4 opacity-[0.12]' title='' />
					</div>
				)
			}
			{
				rating.count > 0 && (
					<a
						href={contacts.twoGisUrl}
						target='_blank'
						rel='noopener noreferrer'
						class='absolute bottom-0 left-0 flex items-center gap-4 bg-cream px-5 py-4 lg:-left-8 lg:bottom-10'
					>
						<span class='text-h2 font-black leading-none'>{rating.value.toFixed(1)}</span>
						<span class='flex flex-col gap-1'>
							<span class='flex gap-0.5' aria-label={`Рейтинг ${rating.value} из 5`}>
								{Array.from({ length: 5 }, () => (
									<Star size={13} fill='currentColor' />
								))}
							</span>
							<span class='text-caption font-medium text-stone'>{rating.count} оценок в 2ГИС</span>
						</span>
					</a>
				)
			}
		</div>
	</div>

	<!-- Краткий прайс и контакты на первом экране -->
	<div class='border-y border-ink/10 bg-paper/50'>
		<div class='section-container grid lg:grid-cols-[1.4fr_1fr]'>
			<ul class='grid grid-cols-2 border-ink/10 md:grid-cols-4 lg:border-r'>
				{
					shortList.map((svc, i) => (
						<li
							class:list={[
								'flex flex-col gap-2 py-6 pr-4',
								i % 2 === 1 && 'pl-4 border-l border-ink/10 md:pl-6',
								i > 1 && 'border-t border-ink/10 md:border-t-0',
								i === 2 && 'md:border-l md:pl-6',
							]}
						>
							<span class='text-body-md text-stone'>{svc?.name}</span>
							<span class='text-h3 font-extrabold'>
								{formatPrice(svc?.price ?? 0)} <span class='text-body-md font-semibold'>сом</span>
							</span>
						</li>
					))
				}
			</ul>
			<div class='flex flex-col justify-center gap-3 border-t border-ink/10 py-6 text-body-md lg:border-t-0 lg:pl-10'>
				<span class='flex items-center gap-3'>
					<MapPin size={16} className='shrink-0' />
					{contacts.address}, {SITE.city}
				</span>
				<span class='flex items-center gap-3'>
					<Clock size={16} className='shrink-0' />
					{contacts.hoursDays}, {contacts.openFrom}–{contacts.openTo}
				</span>
				{
					contacts.phone && (
						<a href={telLink(contacts.phone)} class='flex items-center gap-3 font-semibold'>
							<Phone size={16} className='shrink-0' />
							{displayPhone(contacts.phone)}
						</a>
					)
				}
			</div>
		</div>
	</div>
</section>
