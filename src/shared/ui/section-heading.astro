---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	align?: 'left' | 'center';
	inverted?: boolean;
	id?: string;
	class?: string;
}

const {
	eyebrow,
	title,
	description,
	align = 'left',
	inverted = false,
	id,
	class: className = '',
} = Astro.props;
const center = align === 'center';
---

<div
	class:list={[
		'animate-on-scroll opacity-0 translate-y-6 transition-all duration-700 ease-out-soft',
		'flex flex-col gap-5',
		center && 'items-center text-center',
		className,
	]}
>
	<div class:list={['flex items-center gap-4', center && 'justify-center']}>
		<span class:list={['h-px w-10', inverted ? 'bg-cream/50' : 'bg-ink/40']}></span>
		<span class:list={['eyebrow', inverted && 'text-cream/60']}>{eyebrow}</span>
	</div>
	<h2
		id={id}
		class:list={[
			'text-h2 font-extrabold uppercase tracking-[-0.01em]',
			inverted ? 'text-cream' : 'text-ink',
		]}
	>
		{title}
	</h2>
	{
		description && (
			<p
				class:list={[
					'max-w-[560px] text-body-lg',
					inverted ? 'text-cream/70' : 'text-stone',
				]}
			>
				{description}
			</p>
		)
	}
</div>
