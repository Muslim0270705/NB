---
import { Logo } from '@/shared/ui/logo';

interface Props {
	eyebrow: string;
	title?: string;
	description?: string;
	align?: 'left' | 'center';
	inverted?: boolean;
	id?: string;
	class?: string;
}

const {
	eyebrow,
	title,
	description,
	align = 'left',
	inverted = false,
	id,
	class: className = '',
} = Astro.props;
const center = align === 'center';
---

<!-- Заголовок секции как в Nomad College: линия, знак, подпись, крупный заголовок -->
<div
	class:list={[
		'animate-on-scroll opacity-0 translate-y-6 transition-all duration-700 ease-out',
		'flex flex-col gap-6',
		center && 'items-center text-center',
		className,
	]}
>
	<div class='flex w-full flex-col gap-4'>
		<div
			class:list={[
				'h-px w-full max-w-[416px]',
				center && 'mx-auto',
				inverted ? 'bg-cream/40' : 'bg-ink',
			]}
		>
		</div>
		<div class:list={['flex items-center gap-[11px]', center && 'justify-center']}>
			<Logo variant='mark' inverted={inverted} className='h-5 w-auto shrink-0' title='' />
			<span class:list={['eyebrow', inverted && 'text-cream/60']}>{eyebrow}</span>
		</div>
	</div>
	{
		title && (
			<h2
				id={id}
				class:list={['text-h2 font-bold', inverted ? 'text-cream' : 'text-ink']}
			>
				{title}
			</h2>
		)
	}
	{
		description && (
			<p
				class:list={[
					'max-w-[811px] text-h5 font-normal',
					inverted ? 'text-cream/80' : 'text-ink/80',
				]}
			>
				{description}
			</p>
		)
	}
</div>
