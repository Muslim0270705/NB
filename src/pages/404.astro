---
import Layout from '@/app/layouts/Layout.astro';
import { buttonClass } from '@/shared/ui/button-styles';
---

<Layout title='Страница не найдена' noindex>
	<section class='section-container flex min-h-[80vh] flex-col items-start justify-center gap-6 pt-24'>
		<span class='eyebrow'>Ошибка 404</span>
		<h1 class='text-display font-black uppercase tracking-[-0.04em]'>Мимо</h1>
		<p class='max-w-md text-body-xl text-stone'>
			Такой страницы нет. Зато есть свободное время для стрижки.
		</p>
		<div class='flex flex-wrap gap-3'>
			<a href='/' class={buttonClass('primary', 'lg')}>На главную</a>
			<a href='/#booking' class={buttonClass('outline', 'lg')}>Записаться</a>
		</div>
	</section>
</Layout>
