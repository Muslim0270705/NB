{
	"name": "ns-barber-studio",
	"type": "module",
	"version": "0.1.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"start": "node ./dist/server/entry.mjs",
		"astro": "astro",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/netlify": "^7.0.13",
		"@astrojs/node": "~10.0.6",
		"@astrojs/react": "^5.0.2",
		"@fontsource-variable/montserrat": "^5.2.8",
		"@fontsource/wix-madefor-display": "^5.3.0",
		"@netlify/blobs": "^11.1.8",
		"@tailwindcss/vite": "^4.2.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.1.3",
		"clsx": "^2.1.1",
		"framer-motion": "^12.38.0",
		"lucide-react": "^1.7.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sharp": "^0.34.4",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.4.10",
		"@types/node": "^22.20.5",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"typescript": "^6.0.3"
	}
